#!/bin/bash

### 安装后：准备配置文件与收件目录。
###
### 重要：飞牛的「卸载 → 重装」会清空 TRIM_PKGETC（@appconf），
### 导致用户设置的下载目录、设备名等被重置回默认值。
### 因此在卸载时把配置备份到 TRIM_PKGVAR 之外的位置不现实
### （@appdata 同样会被清），改为在卸载前主动备份到用户可写的共享目录，
### 安装时若发现备份则恢复。
###
### 目录授权由飞牛系统在用户于应用设置中授权时完成，这里只做应用自身资源准备。

CONF_DIR="${TRIM_PKGETC}"
VAR_DIR="${TRIM_PKGVAR}"
CONF_FILE="${CONF_DIR}/config.json"

# 备份位置：收件目录内（@appshare/CompareShare/inbox，卸载时保留且应用用户可写）
INBOX=""
if [ -n "${TRIM_DATA_SHARE_PATHS}" ]; then
    INBOX=$(echo "${TRIM_DATA_SHARE_PATHS}" | cut -d: -f1)
fi
if [ -z "${INBOX}" ]; then
    INBOX="${VAR_DIR}/received"
fi
mkdir -p "${INBOX}" 2>/dev/null
BACKUP_FILE="${INBOX}/.config-backup.json"

mkdir -p "${CONF_DIR}" "${VAR_DIR}" 2>/dev/null
chmod 700 "${INBOX}" 2>/dev/null

# 1) 优先从备份恢复（重装场景：卸载清空了 @appconf，但收件目录保留）
if [ ! -f "${CONF_FILE}" ] && [ -f "${BACKUP_FILE}" ]; then
    cp -f "${BACKUP_FILE}" "${CONF_FILE}" 2>/dev/null && \
        echo "restored config from ${BACKUP_FILE}" >&2
fi

# 2) 仍无配置则写入默认值（首次安装）
if [ ! -f "${CONF_FILE}" ]; then
    /usr/bin/python3 - <<PYEOF
import json, os
conf_dir = os.environ.get("TRIM_PKGETC", "${CONF_DIR}")
inbox = "${INBOX}" or os.path.join(os.environ.get("TRIM_PKGVAR", "${VAR_DIR}"), "received")
data = {
    "alias": os.uname().nodename + " (Compare Share)",
    "download_dir": inbox,
    "port": 53317,
    "web_port": 11011,
    "https": True,
    "pin": "",
    "auto_accept": True,
    "device_model": "fnOS NAS",
    "device_type": "server",
    "announce_interval": 30,
    "interfaces": [],
    "web_upload": True,
}
path = os.path.join(conf_dir, "config.json")
with open(path, "w", encoding="utf-8") as fh:
    json.dump(data, fh, ensure_ascii=False, indent=2)
print("wrote", path)
PYEOF
fi

# 权限交给应用用户，保证以 package 身份运行时可读写
if [ -n "${TRIM_USERNAME}" ]; then
    chown -R "${TRIM_USERNAME}:${TRIM_USERNAME}" "${CONF_DIR}" "${VAR_DIR}" 2>/dev/null
    chown -R "${TRIM_USERNAME}:${TRIM_USERNAME}" "${INBOX}" 2>/dev/null
fi

exit 0
