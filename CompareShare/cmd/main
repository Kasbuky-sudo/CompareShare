#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

ENTRY="${TRIM_APPDEST}/server/main.py"
PYTHON="/usr/bin/python3"

CMD="${PYTHON} ${ENTRY} --host 0.0.0.0 --port 53317 --web-port ${TRIM_SERVICE_PORT:-11011}"

# 进程特征（用于兜底停止，避免误杀其他 python 进程）
PATTERN="${ENTRY}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if [ -n "${pid}" ] && check_process "${pid}"; then
            return 0
        fi
        rm -f "${PID_FILE}"
    fi
    # pidfile 丢失时用进程特征兜底判断
    if pgrep -f "${PATTERN}" > /dev/null 2>&1; then
        return 0
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi

    log_msg "Starting Compare Share ..."

    if [ ! -x "${PYTHON}" ]; then
        log_msg "ERROR: ${PYTHON} not found"
        return 1
    fi

    if [ ! -f "${ENTRY}" ]; then
        log_msg "ERROR: entry not found: ${ENTRY}"
        return 1
    fi

    log_msg "CMD = ${CMD}"

    # 飞牛注入的环境变量（TRIM_API_TOKEN 等）必须显式透传：
    # runuser/切换用户会重置环境，否则应用内无法调用飞牛开放接口。
    ENV_LIST=""
    for name in TRIM_API_TOKEN TRIM_DATA_SHARE_PATHS TRIM_DATA_ACCESSIBLE_PATHS \
                TRIM_USERNAME TRIM_UID TRIM_RUN_USERNAME TRIM_RUN_UID \
                TRIM_APPDEST TRIM_PKGETC TRIM_PKGVAR TRIM_PKGTMP TRIM_PKGHOME \
                TRIM_SERVICE_PORT TRIM_APPDEST_VOL TRIM_SYS_ARCH TRIM_TEMP_LOGFILE; do
        eval "value=\${$name}"
        if [ -n "${value}" ]; then
            ENV_LIST="${ENV_LIST} ${name}=$(printf '%q' "${value}")"
        fi
    done

    if [ "$(id -un)" = "${TRIM_USERNAME}" ]; then
        bash -c "${ENV_LIST} ${CMD}" >> "${LOG_FILE}" 2>&1 &
    else
        runuser -u "${TRIM_USERNAME}" -- bash -c "${ENV_LIST} ${CMD}" >> "${LOG_FILE}" 2>&1 &
    fi

    printf "%s" "$!" > "${PID_FILE}"

    sleep 1
    if status; then
        log_msg "Started OK (pid=$(cat "${PID_FILE}" 2>/dev/null))"
        return 0
    fi

    log_msg "ERROR: process exited immediately, see ${LOG_FILE}"
    return 1
}

stop_process() {
    log_msg "Stopping Compare Share ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        log_msg "pid=${pid}"

        if [ -n "${pid}" ] && check_process "${pid}"; then
            log_msg "send TERM signal to PID:${pid}..."
            kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

            local count=0
            while check_process "${pid}" && [ $count -lt 10 ]; do
                sleep 1
                count=$((count + 1))
            done

            if check_process "${pid}"; then
                log_msg "send KILL signal to PID:${pid}..."
                kill -KILL "${pid}" 2>/dev/null
            fi
        fi
        rm -f "${PID_FILE}"
    fi

    # 兜底：清理可能残留的子进程
    pkill -TERM -f "${PATTERN}" 2>/dev/null || true
    sleep 1
    pkill -KILL -f "${PATTERN}" 2>/dev/null || true

    log_msg "process stopped"
    return 0
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
