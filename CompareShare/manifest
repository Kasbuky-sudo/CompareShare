appname               = CompareShare
version               = 1.2.5
display_name          = Compare Share
desc                  = 局域网极速互传。支持 LocalSend 协议，与手机、电脑、平板直接互传文件，无需云端、无需账号。内置发现服务、收发管理与目录授权。
platform              = all
source                = thirdparty
maintainer            = LocalSend & Kasbuky
maintainer_url        = https://github.com/localsend/localsend
distributor           = Kasbuky
distributor_url       = https://github.com/Kasbuky-sudo
desktop_uidir         = ui
desktop_applaunchname = CompareShare.Application
micro_app             = true
service_port          = 11011
ctl_stop              = true
checkport             = true
disable_authorization_path = false
changelog             = 修复持续占用 CPU 与带宽的问题：此前收到设备的 register 后都会立即回访，两台设备因此无限互相注册，持续建立连接（实测每 10 秒新增数十条 TIME-WAIT，单核占用 90%%以上，线程数持续增长）。现在回访带冷却期（register 来源 5 分钟、多播来源 1 分钟）并增加全局频率上限（12 次/分钟），修复后 CPU 降至 0%%、连接数归零。
