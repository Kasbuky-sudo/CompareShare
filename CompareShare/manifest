appname               = CompareShare
version               = 1.2.0
display_name          = Compare Share
desc                  = 局域网极速互传。支持 LocalSend 协议，与手机、电脑、平板直接互传文件，无需云端、无需账号。内置发现服务、收发管理与目录授权。
platform              = all
source                = thirdparty
maintainer            = LocalSend & Kasbuky
maintainer_url        = https://github.com/localsend/localsend
distributor           = Kasbuky
distributor_url       = https://github.com/Kasbuky-sudo
desktop_uidir         = ui
desktop_applaunchname = CompareShare.Application
micro_app             = true
service_port          = 11011
ctl_stop              = true
checkport             = true
disable_authorization_path = false
changelog             = 1.2.0：新增浏览器上传页。手机不装任何应用，浏览器打开 http://<NAS>:11011/upload 即可传文件；设置页提供二维码，扫码直达。上传复用 LocalSend 的 prepare-upload/upload 端点，PIN 校验与各项安全保护一并生效；可在设置中关闭，关闭后不影响 LocalSend 客户端。另修复本机地址探测：在存在 VPN/虚拟网卡时可能取到错误网段，导致二维码指向不可达地址。1.1.7：目录授权明确要求 fnOS 1.2.0604 及以上。1.1.6：优化旧版系统下授权面板的按钮与提示。1.1.5：修复授权状态接口 500。1.1.4：新增收件目录校验。1.1.2：修正开发者与发布者署名。
