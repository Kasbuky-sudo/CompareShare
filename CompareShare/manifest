appname               = CompareShare
version               = 1.1.2
display_name          = Compare Share
desc                  = 局域网极速互传。支持 LocalSend 协议，与手机、电脑、平板直接互传文件，无需云端、无需账号。内置发现服务、收发管理与目录授权。
platform              = all
source                = thirdparty
maintainer            = LocalSend & Kasbuky
maintainer_url        = https://github.com/localsend/localsend
distributor           = Kasbuky
distributor_url       = https://github.com/Kasbuky-sudo
desktop_uidir         = ui
desktop_applaunchname = CompareShare.Application
micro_app             = true
service_port          = 11011
ctl_stop              = true
checkport             = true
disable_authorization_path = false
changelog             = 1.1.2：修正应用开发者与发布者署名。1.1.1：目录授权面板新增分步引导，系统版本较旧时给出「应用中心 → 已安装 → 应用设置 → 访问权限」的操作路径。1.1.0：修复手机无法向 NAS 发送文件（UnknownCA）；目录选择器按系统版本自动降级。1.0.9：更新应用图标。1.0.8：授权状态显示更准确。1.0.7：优先读取飞牛下发的授权路径。1.0.6：修复授权接口调用失败。1.0.4：修复界面卡在加载状态；新增网段扫描。1.0.2：证书跨重装保留。
